{
  "expo": {
    "scheme": "pennywise",
    "name": "PennyWise",
    "slug": "pennywise-expense-mobile",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8FAFC",
    "primaryColor": "#00C313",
    "ios": {
      "bundleIdentifier": "com.mohammeddev07.pennywise",
      "buildNumber": "1",
      "supportsTablet": true,
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.mohammeddev07.pennywise",
      "softwareKeyboardLayoutMode": "pan",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#00C313"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": false,
          "root": "./src/app"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC"
        }
      ],
      "expo-font",
      "expo-status-bar"
    ],
    "extra": {
      "router": {
        "origin": false,
        "root": "./src/app"
      },
      "eas": {
        "projectId": "8b897271-e9fa-4110-a807-3b5e58483e82"
      }
    }
  }
}
