{
  "expo": {
    "scheme": "pennywise",
    "name": "PennyWise",
    "slug": "pennywise-expense-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": false,
          "root": "./src/app"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ]
  }
}
