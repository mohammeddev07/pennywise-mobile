# Include the backend context path (normally /api).
EXPO_PUBLIC_API_BASE_URL=https://your-pennywise-api.example.com/api

# Set to "true" to run the app entirely against an in-memory mock backend
# (seeded with sample books/categories/transactions/budgets) instead of
# calling EXPO_PUBLIC_API_BASE_URL. Useful for testing on a device/simulator
# with no backend running. See src/shared/api/mockAdapter.ts.
EXPO_PUBLIC_MOCK_API=false
